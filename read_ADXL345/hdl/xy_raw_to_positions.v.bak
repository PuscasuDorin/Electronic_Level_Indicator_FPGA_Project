module xy_raw_to_positions// #(parameter X_RANGE  = 510
													//	,parameter Y_RANGE  = 510
													//	,parameter DISPLAYS = 6
													//	)
(
    input             clk	 ,
    input             rst_n,
    
    input      [15:0] x_data_i,
    input      [15:0] y_data_i,
    
    output reg [2:0]  x_pos_o,
    output reg        y_pos_o
);

//localparam SHIFT_X = $clog2(X_RANGE) / DISPLAYS;
//localparam SHIFT_Y = $clog2(Y_RANGE) / 2;
//localparam MIDDLE  = $clog2(DISPLAYS / 2);

always @(posedge c0 or negedge rst_n)begin
	if(~rst_n) 													 		 x_pos_o <= 3'd2; else
	if(x_data_i >=  0   && x_data_i <=  85 ) x_pos_o <= 3'd3; else
	if(x_data_i >=  86  && x_data_i <=  170) x_pos_o <= 3'd4; else
	if(x_data_i >=  171 && x_data_i <=  255) x_pos_o <= 3'd5; else
	if(x_data_i <   0   && x_data_i >= -85 ) x_pos_o <= 3'd2; else
	if(x_data_i <= -86  && x_data_i >= -170) x_pos_o <= 3'd1; else
	if(x_data_i <= -171 && x_data_i >= -255) x_pos_o <= 3'd0;
end

always @(posedge c0 or negedge rst_n)begin
	if(~rst_n)											  		y_pos_o <= 0; else
	if(y_data_i >= 0 && y_data_i <=  240) y_pos_o <= 1; else
	if(y_data_i <  0 && y_data_i >= -270) y_pos_o <= 0;
end


