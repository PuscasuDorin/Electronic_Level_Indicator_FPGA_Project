module driver_7seg #(parameter NO_SEGMENTS = 48
										,parameter BITS_PER_DISPLAY = 8
									  ,parameter ROWS = 2
									  ,parameter COLUMNS = 6)
(
	input clk  													 		,
	input rst_n													 		,
	input select														,
  input sel_row										 				,
  input [$clog2(COLUMNS+1)-1:0] sel_column,
	output reg [NO_SEGMENTS-1:0] segments				
);
//8 *(sel_column+1)-1:8*sel_column 	

always @(posedge clk or negedge rst_n)
if(~rst_n) segments <= {NO_SEGMENTS{1'b1}}; else
//if(~(&segments)) segments <= segments; else
if(~select)segments <= {NO_SEGMENTS{1'b1}}; else
if(~sel_row) segments[8 *(sel_column+1)-1 -: 8] <= 8'b10011100; else
if(sel_row) segments[8 *(sel_column+1)-1 -: 8] <= 8'b10100011;

endmodule
